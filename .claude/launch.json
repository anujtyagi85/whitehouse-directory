{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Cloudflare Worker (wrangler dev)",
      "runtimeExecutable": "wrangler",
      "runtimeArgs": ["dev", "worker.js", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "Static HTML preview (python)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    }
  ]
}
